---
/**
 * 試翻頁（#169，prototype 定案的版面 A：步驟在上、漫畫在下）。剛裝好外掛的讀者從 onboarding 第 4 步來，用真的工具列圖示
 * 翻一次 Practice Spread；Worker 認出它的文字就不扣頁。不偵測外掛裝了沒、圖示釘選了沒。
 * `?shot`：藏起頁首、頁尾與引導文字，只留置中、填滿視窗高度的 Practice Spread（用正式版外掛重拍 Web Store 截圖）。
 */
import PuzzleIcon from '../../components/PuzzleIcon.astro';
import Base from '../../layouts/Base.astro';
import { copy } from '../../copy.ts';
import { INSTALL_URL } from '../../links.ts';
import { type Locale, LOCALES, byLocale } from '../../locale.ts';
import spread from '../../../../practice-spread/practice-spread.webp';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = copy[locale].try;
/** 步驟內文切成文字與 `{puzzle}`／`{shortcut}` 兩種記號。 */
const parts = (body: string) => body.split(/(\{puzzle\}|\{shortcut\})/);
---
<Base locale={locale} title={`Naruhodo — ${t.title}`} alternates={byLocale((l) => `/${l}/try/`)}>
  <section class="try">
    <div class="wrap guide">
      <h1>{t.title}</h1>
      <p class="lead">{t.lead}<strong>{t.free}</strong></p>
      <ol class="steps">
        {t.steps.map((step) => (
          <li class="card">
            <h3>{step.title}</h3>
            <p>
              {parts(step.body).map((part) =>
                part === '{puzzle}' ? <PuzzleIcon label={t.puzzleLabel} /> : part === '{shortcut}' ? <Fragment><kbd>Alt</kbd>+<kbd>Shift</kbd>+<kbd>M</kbd></Fragment> : part,
              )}
            </p>
          </li>
        ))}
      </ol>
      <p class="hint">{t.notInstalled}<a href={INSTALL_URL}>{t.install}</a></p>
    </div>
    <figure class="spread"><img src={spread.src} width={spread.width} height={spread.height} alt={t.spreadAlt} /></figure>
  </section>
</Base>

<script is:inline>
  // 在 body 畫出來之前加上 class，?shot 的截圖不會閃過引導文字
  if (new URLSearchParams(location.search).has('shot')) document.documentElement.classList.add('shot');
</script>

<style is:global>
  .try .guide { padding: var(--naru-space-6) 0 var(--naru-space-4); }
  .try h1 { margin: 0 0 var(--naru-space-2); }
  .try .lead { max-width: 720px; }
  .try .steps { margin: var(--naru-space-4) 0; }
  .try kbd { padding: 1px 6px; border: 1px solid var(--naru-line-strong); border-bottom-width: 2px; border-radius: 4px; font-family: var(--naru-font-mono); font-size: var(--naru-text-small); background: var(--naru-surface); }
  .try .hint { color: var(--naru-ink-3); font-size: var(--naru-text-small); }
  .try .spread { max-width: 1400px; margin: 0 auto var(--naru-space-6); padding: 0 var(--naru-space-4); }
  .try .spread img { display: block; width: 100%; height: auto; }

  html.shot .site-header, html.shot .site-footer, html.shot .try .guide { display: none !important; }
  html.shot body { background: #fff; }
  html.shot .try .spread { display: flex; align-items: center; justify-content: center; max-width: none; height: 100vh; margin: 0; padding: 0; }
  html.shot .try .spread img { width: auto; max-width: 100%; max-height: 100vh; }
</style>
