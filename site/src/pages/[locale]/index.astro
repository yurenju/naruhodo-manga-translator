---
/** 首頁就是價格頁（#89 A 版）：大標題 → 展示 → 怎麼用 → 方案 → 常見問題。 */
import Copy from '../../components/Copy.astro';
import PricePair from '../../components/PricePair.astro';
import StepBody from '../../components/StepBody.astro';
import Base from '../../layouts/Base.astro';
import '../../styles/demo.css';
import { copy } from '../../copy.ts';
import { INSTALL_URL, legalHref } from '../../links.ts';
import { type Locale, LOCALES, byLocale } from '../../locale.ts';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = copy[locale];
---
<Base locale={locale} title={`${t.brand} — ${t.hero.title}`} alternates={byLocale((l) => `/${l}/`)}>
  <section class="hero">
    <div class="wrap">
      <div class="narrow">
        <h1>{t.hero.title}</h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="cta">
          <a class="btn btn-primary" href={INSTALL_URL}>{t.hero.install}</a>
          <a class="btn btn-ghost" href="#pricing">{t.hero.pricing}</a>
        </div>
      </div>
      <!-- 互動展示（#109）：假 Chrome 視窗＋外掛真正的 side panel 與覆蓋層，由 demo/mount.tsx render -->
      <div class="demo">
        <p class="demo-caption">{t.demo.caption}</p>
        <div data-demo data-copy={JSON.stringify({ hint: t.demo.hint })}></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{t.how.title}</h2>
      <ol class="steps">
        {t.how.steps.map((step) => (
          <li class="card">
            <h3>{step.title}</h3>
            <p><StepBody body={step.body} /></p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="pricing">
    <div class="wrap">
      <h2>{t.pricing.title}</h2>
      <div class="plans">
        <div class="card plan">
          <div class="plan-head"><h3>{t.pricing.free.title}</h3><span class="plan-tag plan-tag--soft">{t.pricing.free.tag}</span></div>
          <p class="price">{t.pricing.free.price}</p>
          <p class="grant">{t.pricing.free.grant.lead} <strong>{t.pricing.free.grant.pages}</strong><span>{t.pricing.free.grant.note}</span></p>
          <ul>{t.pricing.free.items.map((item) => <li><Copy text={item} /></li>)}</ul>
        </div>
        <div class="card plan featured">
          <div class="plan-head"><h3>{t.pricing.sub.title}</h3><span class="plan-tag">{t.pricing.sub.tag}</span></div>
          <PricePair pay={t.pricing.sub.pay} average={t.pricing.sub.average} />
          <ul>{t.pricing.sub.items.map((item) => <li><Copy text={item} /></li>)}</ul>
        </div>
      </div>
      <!-- 卡片裡不放按鈕：訂閱要先有帳號、只能在外掛裡付款（#94），所以唯一的入口是安裝 -->
      <div class="card start">
        <ol class="start-steps">
          {t.pricing.start.steps.map((step, i) => (
            <li><span class="start-num" aria-hidden="true">{i + 1}</span><span><b>{step.title}</b>{step.body}</span></li>
          ))}
        </ol>
        <a class="btn btn-primary" href={INSTALL_URL}>{t.pricing.start.cta}</a>
      </div>
      <p class="own-key">{t.pricing.ownKey}</p>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap narrow faq">
      <h2>{t.faq.title}</h2>
      {t.faq.items.map((item, i) => (
        <details open={i === 0}>
          <summary>{item.q}</summary>
          <p>{item.a.split('{link}').map((part, j) => (
            <>{j > 0 && item.link && <a href={legalHref(item.link, locale)}>{t.legal[item.link]}</a>}{part}</>
          ))}</p>
        </details>
      ))}
    </div>
  </section>
</Base>

<script>
  import '../../demo/mount.tsx';
</script>
