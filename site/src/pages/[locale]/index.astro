---
/** 首頁就是價格頁（#89 A 版）：大標題 → 展示 → 怎麼用 → 方案 → 常見問題。 */
import Copy from '../../components/Copy.astro';
import StepBody from '../../components/StepBody.astro';
import Base from '../../layouts/Base.astro';
import '../../styles/demo.css';
import { copy } from '../../copy.ts';
import { DISCUSSIONS_URL, INSTALL_URL, legalHref } from '../../links.ts';
import { type Locale, LOCALES, byLocale } from '../../locale.ts';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = copy[locale];
---
<Base locale={locale} title={`${t.brand} — ${t.hero.title}`} alternates={byLocale((l) => `/${l}/`)}>
  <section class="hero">
    <div class="wrap">
      <div class="narrow">
        <h1>{t.hero.title}</h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="cta">
          <a class="btn btn-primary" href={INSTALL_URL}>{t.hero.install}</a>
          <a class="btn btn-ghost" href="#pricing">{t.hero.pricing}</a>
        </div>
      </div>
      <!-- 互動展示（#109）：假 Chrome 視窗＋外掛真正的 side panel 與覆蓋層，由 demo/mount.tsx render -->
      <div class="demo">
        <p class="demo-caption">{t.demo.caption}</p>
        <div data-demo data-copy={JSON.stringify({ hint: t.demo.hint })}></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{t.how.title}</h2>
      <ol class="steps">
        {t.how.steps.map((step) => (
          <li class="card">
            <h3>{step.title}</h3>
            <p><StepBody body={step.body} /></p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="pricing">
    <div class="wrap">
      <h2>{t.pricing.title}</h2>
      <p class="pricing-lead">{t.pricing.lead}</p>
      <div class="plans">
        <div class="card plan">
          <div class="plan-head"><h3>{t.pricing.free.title}</h3><span class="plan-tag plan-tag--soft">{t.pricing.free.tag}</span></div>
          {/* 跟訂閱卡的實際扣款那一行同高，三張卡的價格大字對齊 */}
          <p class="charge" aria-hidden="true"></p>
          <p class="price"><strong>{t.pricing.free.price}</strong></p>
          <ul>
            <li>{t.pricing.free.grant.lead} <strong>{t.pricing.free.grant.pages}</strong>{t.pricing.free.grant.note}</li>
            {t.pricing.free.items.map((item) => <li><Copy text={item} /></li>)}
          </ul>
        </div>
        {t.pricing.plans.map((plan) => (
          <div class:list={['card plan', { featured: plan.featured }]}>
            <div class="plan-head"><h3>{plan.title}</h3>{plan.tag && <span class="plan-tag">{plan.tag}</span>}</div>
            <p class="charge">{plan.charge}{plan.saving && <span class="saving">{plan.saving}</span>}</p>
            <p class="price"><small>{plan.averageLabel}</small><strong>{plan.average}</strong>{plan.per}</p>
            <ul>{plan.items.map((item) => <li><Copy text={item} /></li>)}</ul>
          </div>
        ))}
      </div>
      <p class="plans-note">{t.pricing.note}</p>
      <!-- 卡片裡不放按鈕：訂閱要先有帳號、只能在外掛裡付款（#94），所以唯一的入口是安裝；網站打不開外掛，已安裝的人看旁邊那一行 -->
      <div class="card start">
        <ol class="start-steps">
          {t.pricing.start.steps.map((step, i) => (
            <li><span class="start-num" aria-hidden="true">{i + 1}</span><span><b>{step.title}</b>{step.body}</span></li>
          ))}
        </ol>
        <div class="start-cta">
          <a class="btn btn-primary" href={INSTALL_URL}>{t.pricing.start.cta}</a>
          <p>{t.pricing.start.installed}</p>
        </div>
      </div>
      <p class="own-key">{t.pricing.ownKey}</p>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap narrow faq">
      <h2>{t.faq.title}</h2>
      {t.faq.items.map((item, i) => (
        <details open={i === 0}>
          <summary>{item.q}</summary>
          <p>{item.a.split('{link}').map((part, j) => (
            <>{j > 0 && item.link && (item.link === 'discussions'
              ? <a href={DISCUSSIONS_URL}>{t.faq.discussions}</a>
              : <a href={legalHref(item.link, locale)}>{t.legal[item.link]}</a>)}{part}</>
          ))}</p>
        </details>
      ))}
    </div>
  </section>
</Base>

<script>
  import '../../demo/mount.tsx';
</script>
