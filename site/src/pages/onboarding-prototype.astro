---
/**
 * PROTOTYPE（拋棄式）：onboarding 的模型下載告知＋第 4 步「到試翻頁試試看」，?variant=A|B|C。
 * 外掛頁面要載入外掛才看得到，所以先借網站的 dev server 跑；樣式直接讀外掛的 tokens／components／onboarding.css。
 */
import '../../../src/shared/tokens.css';
import '../../../src/ui/components.css';
import '../../../src/onboarding/onboarding.css';
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Naruhodo：開始設定（prototype）</title>
  </head>
  <body>
    <div id="app"></div>
    <style is:global>
      .proto-panel { position: fixed; bottom: 64px; left: 8px; z-index: 100; display: flex; flex-direction: column; gap: 2px; max-width: 200px; opacity: 0.9; padding: 8px 10px; border: 1px dashed #999; border-radius: 8px; background: #fffbe6; font: 12px system-ui; }
      .proto-panel code { margin-top: 4px; font-size: 11px; }
      .proto-pill { position: fixed; right: 16px; bottom: 16px; display: flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: var(--naru-surface); box-shadow: var(--naru-shadow-1); font-size: var(--naru-text-caption); color: var(--naru-ink-2); }
      .proto-pill.ok { color: var(--naru-ok); background: var(--naru-ok-bg); }
      .proto-spin { width: 10px; height: 10px; border: 2px solid var(--naru-line-strong); border-top-color: var(--naru-accent); border-radius: 50%; animation: proto-spin 0.8s linear infinite; }
      @keyframes proto-spin { to { transform: rotate(360deg); } }
      .proto-topbar { display: flex; flex-direction: column; align-items: center; gap: 4px; width: min(600px, 100%); margin-bottom: var(--naru-space-3); font-size: var(--naru-text-caption); color: var(--naru-ink-3); }
      .proto-topbar__track { width: 100%; height: 4px; border-radius: 999px; background: var(--naru-line); overflow: hidden; }
      .proto-topbar__fill { height: 100%; background: var(--naru-accent); transition: width 0.1s linear; }
      .proto-notice { margin: 0 0 var(--naru-space-4); font-size: var(--naru-text-small); color: var(--naru-ink-2); }
      .proto-optin { display: flex; gap: 8px; align-items: flex-start; margin: 0 0 var(--naru-space-4); font-size: var(--naru-text-small); }
      .proto-status { margin: var(--naru-space-3) 0 0; padding: var(--naru-space-2) var(--naru-space-3); border-radius: var(--naru-radius-md); background: var(--naru-surface-2); font-size: var(--naru-text-small); }
      .proto-status.ok { background: var(--naru-ok-bg); color: var(--naru-ok); }
    </style>
    <script>
      import '../prototype/OnboardingPrototype.tsx';
    </script>
  </body>
</html>
