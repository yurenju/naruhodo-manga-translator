// Hosted Translation 的 Worker（ADR 0006）。最上層是 production；本機用 env.dev 或 env.test：
//   npm run worker:dev                                    env.dev：真的 Anthropic 與 Paddle sandbox（scripts/worker-dev.ts）
//   npx wrangler dev -c worker/wrangler.jsonc --env test  假的 Anthropic（FakeTranslator），browser test 用
// 兩個本機 env 的寄信都是假的（FAKE_MAIL）：驗證碼印在終端機，也能從 /v1/dev/outbox 取得。
// 兩個本機 env 也開放開發用的端點（DEV_ENDPOINTS）：/v1/dev/free-pages 直接設定免費額度。
// define 與 vars、d1_databases、ratelimits 都不會從最上層繼承，每個 env 各寫一次。
// 寄送驗證碼的頻率限制：同一個 IP 每分鐘 10 次、同一個 email 每分鐘 3 次（畫面上 30 秒後才能重新寄送）。
// 驗證的頻率限制：同一個 IP 每分鐘 30 次、同一個 email 每分鐘 20 次；同一個 email 一小時內最多驗證 10 次另外記在 D1（auth.ts）。
// Daily Free Pages Cap（#241）：DAILY_FREE_PAGES_CAP 是全站每天（UTC）最多送出的 Free Pages；最壞一天約 $2.2。到了上限只擋只靠 Free Pages 的 Account，
//   不像 Anthropic Console 的支出上限會連訂閱者一起停。
// Paddle（#94）：MONTHLY_PAGE_LIMIT 是訂閱者每月可翻的頁數。SITE_ORIGIN 是 checkout 頁所在的產品網站（Worker 自己組 checkout 網址）。
//   env.dev 打 Paddle sandbox；env.test 的 __FAKE_PADDLE__ 換成假的 Paddle，webhook secret 是測試用的假值。
// env.dev 的 secrets.required（#175）：有這個欄位，wrangler dev 會把 process env 一起讀進來，只綁定列出的名稱。
//   CLAUDE_API_KEY 由 op run 從 1Password 放進 env（scripts/with-op.ts），不寫進 .dev.vars；
//   Paddle 的四個值由 --env-file ~/.config/naruhodo/paddle-sandbox.env 讀。
// production（#97）：CI 在合併到 main 後部署（.github/workflows/ci.yml 的 deploy-worker，ADR 0008）。
//   secrets（只存在 Cloudflare）：CLAUDE_API_KEY、RESEND_API_KEY、PADDLE_API_KEY、PADDLE_PRICE_ID_QUARTERLY、PADDLE_PRICE_ID_YEARLY、PADDLE_WEBHOOK_SECRET，
//   在 Cloudflare 後台 naruhodo-api → Settings → Variables and Secrets 設定（本機沒有寫入權，ADR 0011）；
//   scripts/production-wizard.sh 帶你做。兩個 price id（季繳、年繳）不是秘密，但跟本機一樣當 secret，換價格不用改這個檔。
//   observability：Workers Logs 留 7 天，本機用 npm run prod:logs 查（ADR 0011）。本機 wrangler dev 不受影響。
//   routes 的 custom_domain：部署時 Cloudflare 自動建 api.naruhodo.page 的 DNS 記錄與 HTTPS 憑證。
//   env.dev 有的 vars，最上層也要有（FAKE_MAIL、DEV_ENDPOINTS 除外），由 scripts/wrangler-config.test.ts 檢查。
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "naruhodo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "api.naruhodo.page", "custom_domain": true }],
  "observability": { "enabled": true },
  // 正式的 database_id：在 Cloudflare 後台建立 D1 後填入（scripts/production-wizard.sh）；本機 D1 不看這個值。
  // prod:sql 的 proxy 只查這個資料庫（scripts/prod-proxy.ts）
  "d1_databases": [{ "binding": "DB", "database_name": "naruhodo", "database_id": "854c2265-33f5-4a51-8708-3f1fc4b5a3d5", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "SEND_CODE_BY_IP", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SEND_CODE_BY_EMAIL", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
    { "name": "VERIFY_CODE_BY_IP", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    { "name": "VERIFY_CODE_BY_EMAIL", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } },
    { "name": "SERIES_GUESS_BY_ACCOUNT", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "MONTHLY_PAGE_LIMIT": "3000",
    "DAILY_FREE_PAGES_CAP": "2000",
    "SITE_ORIGIN": "https://naruhodo.page",
    "PADDLE_API_BASE_URL": "https://api.paddle.com",
    // 寄件網域用子網域：寄信的信譽跟主網域分開（Resend 的建議）
    "MAIL_FROM": "Naruhodo <noreply@mail.naruhodo.page>"
  },
  "define": { "__FAKE_ANTHROPIC__": "false", "__FAKE_PADDLE__": "false" },
  "env": {
    "dev": {
      "vars": {
        "FAKE_MAIL": "true",
        "DEV_ENDPOINTS": "true",
        "MONTHLY_PAGE_LIMIT": "3000",
        "DAILY_FREE_PAGES_CAP": "2000",
        "SITE_ORIGIN": "http://localhost:4321",
        "PADDLE_API_BASE_URL": "https://sandbox-api.paddle.com"
      },
      "secrets": { "required": ["CLAUDE_API_KEY", "PADDLE_API_KEY", "PADDLE_PRICE_ID_QUARTERLY", "PADDLE_PRICE_ID_YEARLY", "PADDLE_WEBHOOK_SECRET"] },
      "d1_databases": [{ "binding": "DB", "database_name": "naruhodo", "database_id": "local", "migrations_dir": "migrations" }],
      "ratelimits": [
        { "name": "SEND_CODE_BY_IP", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "SEND_CODE_BY_EMAIL", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
        { "name": "VERIFY_CODE_BY_IP", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
        { "name": "VERIFY_CODE_BY_EMAIL", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } },
        { "name": "SERIES_GUESS_BY_ACCOUNT", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } }
      ],
      "define": { "__FAKE_ANTHROPIC__": "false", "__FAKE_PADDLE__": "false" }
    },
    "test": {
      "vars": {
        "FAKE_MAIL": "true",
        "DEV_ENDPOINTS": "true",
        "MONTHLY_PAGE_LIMIT": "3000",
        "DAILY_FREE_PAGES_CAP": "2000",
        "SITE_ORIGIN": "http://localhost:4321",
        "PADDLE_WEBHOOK_SECRET": "pdl_ntfset_browser_test"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "naruhodo", "database_id": "local", "migrations_dir": "migrations" }],
      // browser test 全部從 localhost 登入、每個測試一個新 email：照 production 的每 IP 每分鐘 10 次，一分鐘內登入超過 10 次的那個測試就拿到「嘗試太頻繁」。
      // 這兩個每 IP 的限制在 env.test 放寬；頻率限制本身由 worker/src/auth.test.ts 在 env.dev 測。
      "ratelimits": [
        { "name": "SEND_CODE_BY_IP", "namespace_id": "1001", "simple": { "limit": 1000, "period": 60 } },
        { "name": "SEND_CODE_BY_EMAIL", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
        { "name": "VERIFY_CODE_BY_IP", "namespace_id": "1003", "simple": { "limit": 1000, "period": 60 } },
        { "name": "VERIFY_CODE_BY_EMAIL", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } },
        { "name": "SERIES_GUESS_BY_ACCOUNT", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } }
      ],
      "define": { "__FAKE_ANTHROPIC__": "true", "__FAKE_PADDLE__": "true" }
    }
  }
}
